# UNACCEPTED integration template. Rendering does not approve build/publication.
# shellcheck shell=bash
pkgname=koma
pkgver='@VERSION@'
pkgrel=1
pkgdesc='Wayland tiling compositor with explicit desktop automation interfaces'
arch=('x86_64' 'aarch64')
url='https://github.com/komawm/koma'
license=('GPL-3.0-or-later')
# Runtime libraries derived from ldd of the v0.0.1 binaries (libseat is shipped by seatd).
depends=('gcc-libs' 'glibc' 'libdrm' 'libinput' 'libxkbcommon' 'mesa' 'pipewire' 'seatd' 'systemd-libs' 'libglvnd' 'wayland')
makedepends=('rustup' 'pkgconf' 'dbus' 'fontconfig' 'clang')
optdepends=('xwayland-satellite: X11 client support' 'xdg-desktop-portal-gnome: screencast and file portals' 'polkit: VT switching under systemd-logind without seatd' 'jiku: optional desktop orchestration companion daemon')
# Release profile emits no debug info; avoid an empty koma-debug split package.
options=('!debug' '!lto')
_source_commit='@SOURCE_COMMIT@'
source=("koma-${_source_commit}.tar.gz::https://github.com/komawm/koma/archive/${_source_commit}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "koma-${_source_commit}" || return 1
    if [[ ! -f Cargo.lock ]]; then
        printf '%s\n' 'Release build requires a reviewed, committed Cargo.lock' >&2
        return 1
    fi
    # Honor the repository's pinned toolchain (rust-toolchain.toml) instead of the distro rust.
    local channel
    channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
    rustup toolchain install --profile minimal "$channel"
    cargo build --release --locked --package koma --package komactl \
        --package koma-overview --package koma-portal
}

package() {
    cd "koma-${_source_commit}" || return 1
    install -Dm755 target/release/koma "$pkgdir/usr/bin/koma"
    install -Dm755 target/release/komactl "$pkgdir/usr/bin/komactl"
    install -Dm755 target/release/koma-overview "$pkgdir/usr/bin/koma-overview"
    install -Dm755 target/release/xdg-desktop-portal-koma "$pkgdir/usr/bin/xdg-desktop-portal-koma"
    install -Dm755 resources/koma-session "$pkgdir/usr/bin/koma-session"
    install -Dm644 resources/koma.desktop "$pkgdir/usr/share/wayland-sessions/koma.desktop"
    install -Dm644 resources/koma.service "$pkgdir/usr/lib/systemd/user/koma.service"
    install -Dm644 resources/koma-shutdown.target "$pkgdir/usr/lib/systemd/user/koma-shutdown.target"
    # Same location as Koma's resources/install-session.sh; XDG_CURRENT_DESKTOP=koma selects it.
    install -Dm644 resources/koma-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/koma-portals.conf"
    install -Dm644 resources/koma.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/koma.portal"
    install -Dm644 resources/org.freedesktop.impl.portal.desktop.koma.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.koma.service"
    install -Dm644 resources/xdg-desktop-portal-koma.service "$pkgdir/usr/lib/systemd/user/xdg-desktop-portal-koma.service"
    # Example only: never overwrite a system greetd configuration from a package.
    install -Dm644 resources/greetd-config.toml "$pkgdir/usr/share/doc/koma/examples/greetd-config.toml"
    install -Dm644 examples/init.lua "$pkgdir/usr/share/doc/koma/examples/init.lua"
    install -d "$pkgdir/usr/share/bash-completion/completions" \
        "$pkgdir/usr/share/zsh/site-functions" \
        "$pkgdir/usr/share/fish/vendor_completions.d"
    ./target/release/koma completions bash > "$pkgdir/usr/share/bash-completion/completions/koma"
    ./target/release/koma completions zsh > "$pkgdir/usr/share/zsh/site-functions/_koma"
    ./target/release/koma completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/koma.fish"
    ./target/release/komactl completions bash > "$pkgdir/usr/share/bash-completion/completions/komactl"
    ./target/release/komactl completions zsh > "$pkgdir/usr/share/zsh/site-functions/_komactl"
    ./target/release/komactl completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/komactl.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/koma/LICENSE"
}

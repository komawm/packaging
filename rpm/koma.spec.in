# UNACCEPTED integration template. Rendering does not approve build/publication.
%global debug_package %{nil}
%global source_commit @SOURCE_COMMIT@

Name:           koma
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Wayland tiling compositor with explicit desktop automation interfaces
License:        GPL-3.0-or-later
URL:            https://github.com/komawm/koma
ExclusiveArch:  x86_64 aarch64
Source0:        https://github.com/komawm/koma/archive/%{source_commit}.tar.gz#/koma-%{source_commit}.tar.gz

BuildRequires:  clang-devel
BuildRequires:  dbus-devel
BuildRequires:  fontconfig-devel
BuildRequires:  libinput-devel
BuildRequires:  libseat-devel
BuildRequires:  libxkbcommon-devel
BuildRequires:  mesa-libEGL-devel
BuildRequires:  mesa-libgbm-devel
BuildRequires:  pipewire-devel
BuildRequires:  pkgconf-pkg-config
BuildRequires:  rustup
BuildRequires:  systemd-devel
BuildRequires:  wayland-devel

Requires:       libdrm
Requires:       libinput
Requires:       libwayland-client
Requires:       libwayland-server
Requires:       libxkbcommon
Requires:       mesa-libEGL
Requires:       mesa-libgbm
Requires:       pipewire-libs
Requires:       seatd-libs
Requires:       systemd-libs

Recommends:     xdg-desktop-portal-gnome
Suggests:       greetd

%description
Koma is a Wayland tiling compositor built in Rust with explicit desktop
automation and IPC interfaces, shipping koma, komactl, and koma-overview.
MCP tooling is available via the `koma mcp` subcommand.

%prep
echo "@SOURCE_SHA256@  %{SOURCE0}" | sha256sum -c -
%autosetup -n koma-%{source_commit}

%build
test -f Cargo.lock
if command -v rustup-init >/dev/null 2>&1 && ! command -v cargo >/dev/null 2>&1; then
    channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
    rustup-init -y --profile minimal --no-modify-path --default-toolchain "$channel"
    export PATH="${HOME}/.cargo/bin:${PATH}"
elif command -v rustup >/dev/null 2>&1; then
    channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
    rustup toolchain install --profile minimal "$channel"
fi
cargo build --release --locked --package koma --package komactl \
    --package koma-overview --package koma-portal

%install
install -Dm755 target/release/koma %{buildroot}%{_bindir}/koma
install -Dm755 target/release/komactl %{buildroot}%{_bindir}/komactl
install -Dm755 target/release/koma-overview %{buildroot}%{_bindir}/koma-overview
install -Dm755 target/release/xdg-desktop-portal-koma %{buildroot}%{_bindir}/xdg-desktop-portal-koma
install -Dm755 resources/koma-session %{buildroot}%{_bindir}/koma-session
install -Dm644 resources/koma.desktop %{buildroot}%{_datadir}/wayland-sessions/koma.desktop
install -Dm644 resources/koma.service %{buildroot}%{_userunitdir}/koma.service
install -Dm644 resources/koma-shutdown.target %{buildroot}%{_userunitdir}/koma-shutdown.target
install -Dm644 resources/koma-portals.conf %{buildroot}%{_datadir}/xdg-desktop-portal/koma-portals.conf
install -Dm644 resources/koma.portal %{buildroot}%{_datadir}/xdg-desktop-portal/portals/koma.portal
install -Dm644 resources/org.freedesktop.impl.portal.desktop.koma.service %{buildroot}%{_datadir}/dbus-1/services/org.freedesktop.impl.portal.desktop.koma.service
install -Dm644 resources/xdg-desktop-portal-koma.service %{buildroot}%{_userunitdir}/xdg-desktop-portal-koma.service
install -Dm644 resources/greetd-config.toml %{buildroot}%{_pkgdocdir}/examples/greetd-config.toml
install -Dm644 examples/init.lua %{buildroot}%{_pkgdocdir}/examples/init.lua

%files
%license LICENSE
%doc %{_pkgdocdir}/examples/greetd-config.toml
%doc %{_pkgdocdir}/examples/init.lua
%{_bindir}/koma
%{_bindir}/komactl
%{_bindir}/koma-overview
%{_bindir}/xdg-desktop-portal-koma
%{_bindir}/koma-session
%{_datadir}/wayland-sessions/koma.desktop
%{_userunitdir}/koma.service
%{_userunitdir}/koma-shutdown.target
%{_datadir}/xdg-desktop-portal/koma-portals.conf
%{_datadir}/xdg-desktop-portal/portals/koma.portal
%{_datadir}/dbus-1/services/org.freedesktop.impl.portal.desktop.koma.service
%{_userunitdir}/xdg-desktop-portal-koma.service

%changelog
* Sat Nov 14 2026 Koma Packaging <packaging@komawm.org> - @VERSION@-1
- Unaccepted development packaging candidate for commit @SOURCE_COMMIT@

# UNACCEPTED integration template. Rendering does not approve build/publication.
# Source tarball checksum recorded at render time: @SOURCE_SHA256@
{
  description = "Koma Wayland tiling compositor (@VERSION@, unaccepted packaging candidate)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    koma-src = {
      url = "github:komawm/koma/@SOURCE_COMMIT@";
      flake = false;
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      koma-src,
    }:
    let
      supportedSystems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      forAllSystems = nixpkgs.lib.genAttrs supportedSystems;
      mkKoma =
        system:
        nixpkgs.legacyPackages.${system}.callPackage ./koma.nix {
          src = koma-src;
          lockFile = "${koma-src}/Cargo.lock";
        };
    in
    {
      packages = forAllSystems (
        system:
        let
          komaPkg = mkKoma system;
        in
        {
          koma = komaPkg;
          default = komaPkg;
        }
      );

      checks = forAllSystems (system: {
        koma = mkKoma system;
      });
    };
}

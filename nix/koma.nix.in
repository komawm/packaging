# UNACCEPTED integration template. Rendering does not approve build/publication.
{
  lib,
  rustPlatform,
  fetchurl,
  pkg-config,
  dbus,
  fontconfig,
  libGL,
  libgbm,
  libinput,
  libxkbcommon,
  pipewire,
  seatd,
  systemd,
  wayland,
  src ? fetchurl {
    url = "https://github.com/komawm/koma/archive/@SOURCE_COMMIT@.tar.gz";
    sha256 = "@SOURCE_SHA256@";
  },
  lockFile ? "${src}/Cargo.lock",
}:

rustPlatform.buildRustPackage {
  pname = "koma";
  version = "@VERSION@";
  inherit src;

  cargoLock = {
    inherit lockFile;
    allowBuiltinFetchGit = true;
  };

  cargoBuildFlags = [
    "--locked"
    "-p"
    "koma"
    "-p"
    "komactl"
    "-p"
    "koma-overview"
    "-p"
    "koma-portal"
  ];

  cargoTestFlags = [
    "--locked"
    "--workspace"
  ];

  nativeBuildInputs = [
    rustPlatform.bindgenHook
    pkg-config
  ];

  buildInputs = [
    dbus
    fontconfig
    libGL
    libgbm
    libinput
    libxkbcommon
    pipewire
    seatd
    systemd
    wayland
  ];

  env = {
    # Keep dlopen'd graphics and Wayland libraries in RPATH on NixOS.
    RUSTFLAGS = toString (
      map (arg: "-C link-arg=" + arg) [
        "-Wl,--push-state,--no-as-needed"
        "-lEGL"
        "-lwayland-client"
        "-lwayland-server"
        "-Wl,--pop-state"
      ]
    );
  };

  postPatch = ''
    patchShebangs resources/koma-session
    substituteInPlace resources/koma.service \
      --replace-fail 'ExecStart=koma' "ExecStart=$out/bin/koma"
    substituteInPlace resources/xdg-desktop-portal-koma.service \
      --replace-fail '/usr/bin/xdg-desktop-portal-koma' "$out/bin/xdg-desktop-portal-koma"
    substituteInPlace resources/org.freedesktop.impl.portal.desktop.koma.service \
      --replace-fail '/usr/bin/xdg-desktop-portal-koma' "$out/bin/xdg-desktop-portal-koma"
  '';

  postInstall = ''
    install -Dm755 resources/koma-session "$out/bin/koma-session"
    install -Dm644 resources/koma.desktop "$out/share/wayland-sessions/koma.desktop"
    install -Dm644 resources/koma.service "$out/lib/systemd/user/koma.service"
    install -Dm644 resources/koma-shutdown.target "$out/lib/systemd/user/koma-shutdown.target"
    install -Dm644 resources/koma-portals.conf "$out/share/xdg-desktop-portal/koma-portals.conf"
    install -Dm644 resources/koma.portal "$out/share/xdg-desktop-portal/portals/koma.portal"
    install -Dm644 resources/org.freedesktop.impl.portal.desktop.koma.service "$out/share/dbus-1/services/org.freedesktop.impl.portal.desktop.koma.service"
    install -Dm644 resources/xdg-desktop-portal-koma.service "$out/lib/systemd/user/xdg-desktop-portal-koma.service"
    install -Dm644 resources/greetd-config.toml "$out/share/doc/koma/examples/greetd-config.toml"
    install -Dm644 examples/init.lua "$out/share/doc/koma/examples/init.lua"
    install -Dm644 LICENSE "$out/share/licenses/koma/LICENSE"
  '';

  passthru = {
    providedSessions = [ "koma" ];
  };

  meta = {
    description = "Wayland tiling compositor with explicit desktop automation interfaces";
    homepage = "https://github.com/komawm/koma";
    license = lib.licenses.gpl3Plus;
    mainProgram = "koma";
    platforms = lib.platforms.linux;
  };
}

# UNACCEPTED integration template (experimental / runtime-unverified).
# Rendering does not approve build, FreeBSD portability, or publication.

PORTNAME=	koma
PORTVERSION=	@VERSION@
CATEGORIES=	x11-wm wayland

MASTER_SITES=	https://github.com/komawm/koma/archive/
DISTFILES=	@SOURCE_COMMIT@.tar.gz
DIST_SUBDIR=	koma
WRKSRC=		${WRKDIR}/koma-@SOURCE_COMMIT@

MAINTAINER=	packaging@komawm.org
COMMENT=	Wayland tiling compositor with explicit desktop automation interfaces
WWW=		https://github.com/komawm/koma

LICENSE=	GPLv3+
LICENSE_FILE=	${WRKSRC}/LICENSE

ONLY_FOR_ARCHS=	amd64 aarch64
ONLY_FOR_ARCHS_REASON=	Candidate packaging target covers FreeBSD 15+ amd64 and aarch64

LIB_DEPENDS=	libdbus-1.so:devel/dbus \
		libdrm.so:graphics/libdrm \
		libfontconfig.so:x11-fonts/fontconfig \
		libinput.so:x11/libinput \
		libseat.so:sysutils/seatd \
		libudev.so:devel/libudev-devd \
		libwayland-server.so:graphics/wayland \
		libxkbcommon.so:x11/libxkbcommon

USES=		cargo gl pkgconfig
USE_GL=		egl gbm glesv2

# Expected archive SHA-256 verified via distinfo: @SOURCE_SHA256@
CARGO_BUILD_ARGS=	--locked -p koma -p komactl -p koma-mcp -p koma-overview

do-install:
	@${MKDIR} ${STAGEDIR}${PREFIX}/bin
	${INSTALL_PROGRAM} ${CARGO_TARGET_DIR}/release/koma ${STAGEDIR}${PREFIX}/bin/koma
	${INSTALL_PROGRAM} ${CARGO_TARGET_DIR}/release/komactl ${STAGEDIR}${PREFIX}/bin/komactl
	${INSTALL_PROGRAM} ${CARGO_TARGET_DIR}/release/koma-mcp ${STAGEDIR}${PREFIX}/bin/koma-mcp
	${INSTALL_PROGRAM} ${CARGO_TARGET_DIR}/release/koma-overview ${STAGEDIR}${PREFIX}/bin/koma-overview
	${INSTALL_SCRIPT} ${WRKSRC}/resources/koma-session ${STAGEDIR}${PREFIX}/bin/koma-session
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/wayland-sessions
	${INSTALL_DATA} ${WRKSRC}/resources/koma.desktop ${STAGEDIR}${PREFIX}/share/wayland-sessions/koma.desktop
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/xdg-desktop-portal
	${INSTALL_DATA} ${WRKSRC}/resources/koma-portals.conf ${STAGEDIR}${PREFIX}/share/xdg-desktop-portal/koma-portals.conf
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/doc/koma/examples
	${INSTALL_DATA} ${WRKSRC}/resources/greetd-config.toml ${STAGEDIR}${PREFIX}/share/doc/koma/examples/greetd-config.toml
	${INSTALL_DATA} ${WRKSRC}/examples/init.lua ${STAGEDIR}${PREFIX}/share/doc/koma/examples/init.lua
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/licenses/koma
	${INSTALL_DATA} ${WRKSRC}/LICENSE ${STAGEDIR}${PREFIX}/share/licenses/koma/LICENSE

.include <bsd.port.mk>
